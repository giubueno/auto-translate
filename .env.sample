# Saddleback configuration.
#
# Copy this file to ".env" at the project root (the project's .gitignore
# already excludes .env). Every value is optional — uncomment and edit only
# the keys you want to override. Defaults shown after each `# default:` line.
#
# Lookup order (lowest -> highest precedence):
#   1. Built-in defaults (src/saddleback/config.py)
#   2. Existing environment variables in your shell
#   3. Variables from this .env file (only set if not already in env)
#
# A value already exported in the shell WINS over the .env file.

# ============================================================================
# Translator (LM Studio, OpenAI-compatible HTTP API)
# ============================================================================

# default: http://localhost:1234/v1
# Point this at wherever LM Studio's local server is running. If LM Studio
# runs on another machine on your LAN, set its IP here, e.g.
#   SADDLEBACK_TRANSLATOR_ENDPOINT=http://192.168.0.50:1234/v1
# SADDLEBACK_TRANSLATOR_ENDPOINT=http://localhost:1234/v1

# default: google/gemma-4-e4b
# Must match a model loaded in your LM Studio instance.
# SADDLEBACK_TRANSLATOR_MODEL=google/gemma-4-e4b

# default: lm-studio
# LM Studio ignores the API key but the OpenAI SDK requires a non-empty value.
# SADDLEBACK_TRANSLATOR_API_KEY=lm-studio

# default: 0.2
# SADDLEBACK_TRANSLATOR_TEMPERATURE=0.2

# default: 4
# Max concurrent translation requests in flight. Lower if LM Studio drops
# connections under load.
# SADDLEBACK_TRANSLATOR_MAX_CONCURRENCY=4

# default: 60
# Per-request timeout in seconds.
# SADDLEBACK_TRANSLATOR_TIMEOUT_SECONDS=60

# ============================================================================
# Transcribe (faster-whisper)
# ============================================================================

# default: large-v3-turbo
# Alternatives: large-v3, large-v2, medium, small. Turbo is ~3x faster than
# plain large-v3 on CPU int8 at comparable accuracy.
# SADDLEBACK_TRANSCRIBE_MODEL=large-v3-turbo

# default: cpu
# Use "cpu" on Apple Silicon (MLX device support in faster-whisper is limited).
# SADDLEBACK_TRANSCRIBE_DEVICE=cpu

# default: int8
# SADDLEBACK_TRANSCRIBE_COMPUTE_TYPE=int8

# default: en
# Source language code. Set "" or "auto" to let Whisper detect.
# SADDLEBACK_TRANSCRIBE_LANGUAGE=en

# default: 5
# SADDLEBACK_TRANSCRIBE_BEAM_SIZE=5

# ============================================================================
# TTS (Qwen3-TTS via mlx_audio)
# ============================================================================

# default: mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
# Alternative for tighter RAM: mlx-community/Qwen3-TTS-12Hz-0.86B-Base-8bit
# SADDLEBACK_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit

# default: 24000
# Output sample rate (Hz). Should match the model's native rate.
# SADDLEBACK_TTS_SAMPLE_RATE_OUT=24000

# default: 3.0
# SADDLEBACK_TTS_REF_MIN_SECONDS=3.0

# default: 8.0
# SADDLEBACK_TTS_REF_MAX_SECONDS=8.0

# default: 0.7
# SADDLEBACK_TTS_TEMPERATURE=0.7

# ============================================================================
# Output (final MP4)
# ============================================================================

# default: mp4
# Comma-separated list of output container formats. MVP supports mp4 only.
# SADDLEBACK_OUTPUT_FORMATS=mp4

# default: true
# Copy the source video stream without re-encoding (fast, no quality loss).
# SADDLEBACK_OUTPUT_COPY_VIDEO=true

# default: aac
# SADDLEBACK_OUTPUT_AUDIO_CODEC=aac

# default: 192
# Output audio bitrate (kbps).
# SADDLEBACK_OUTPUT_AUDIO_BITRATE_K=192

# ============================================================================
# Runtime
# ============================================================================

# default: ./runs
# Directory where per-job state (audio.wav, segments.json, tts/, etc.) lives.
# SADDLEBACK_RUNTIME_RUNS_DIR=./runs

# default: true
# Keep per-stage intermediate artifacts on disk after a successful run.
# Set false to keep only the final MP4s (the `clean` subcommand also does this).
# SADDLEBACK_RUNTIME_KEEP_INTERMEDIATE=true

# default: true
# Run multiple translation requests concurrently (bounded by
# SADDLEBACK_TRANSLATOR_MAX_CONCURRENCY).
# SADDLEBACK_RUNTIME_PARALLEL_TRANSLATE=true

# default: false
# DO NOT enable in MVP — TTS holds ~7 GB peak RSS; concurrent calls OOM
# a 16 GB Mac.
# SADDLEBACK_RUNTIME_PARALLEL_TTS=false

# default: false
# Deterministic test mode: mocked translator + stub TTS, no network, no
# heavy model loads. Use in CI and for pipeline-shape verification.
# SADDLEBACK_RUNTIME_TEST_MODE=false

# default: 1.3
# Max ratio of target-language words to source-language words per segment.
# Translations exceeding this are flagged for shortening.
# SADDLEBACK_RUNTIME_LENGTH_BUDGET_RATIO=1.3

# default: 0.85
# Quality threshold for the round-trip similarity check in the report.
# Segments below this are flagged for operator review.
# SADDLEBACK_RUNTIME_SIMILARITY_THRESHOLD=0.85

# ============================================================================
# Targets (dub languages)
# ============================================================================

# default: de,es
# Comma-separated list. MVP supports "de" and "es" only.
# SADDLEBACK_TARGETS_LANGUAGES=de,es
